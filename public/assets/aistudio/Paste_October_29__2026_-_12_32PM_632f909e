## STEP 0: Database (run in Supabase SQL Editor)

This wipes the old test data and adds database-level safety. Read it once before running.
The SQL Editor bypasses RLS, so you can run it. **If any statement errors, paste the error to Claude and do not continue.**

```sql
-- ============ 0. FRESH START (deletes all existing rows) ============
delete from appointments;

-- ============ 1. Columns and tables ============
alter table appointments add column if not exists reason text;
alter table appointments add column if not exists visit_type text default 'In clinic';
alter table appointments add column if not exists seed_key text;
create unique index if not exists uq_appointments_seed_key
  on appointments (seed_key) where seed_key is not null;

create table if not exists waitlist (
  id uuid primary key default gen_random_uuid(),
  client_name text not null,
  phone text not null,
  date date not null,
  notified boolean not null default false,
  created_at timestamptz not null default now()
);

create table if not exists audit_log (
  id bigint generated always as identity primary key,
  appointment_id uuid,
  action text not null,
  old_status text,
  new_status text,
  details jsonb,
  changed_at timestamptz not null default now()
);

-- ============ 2. Validation constraints (NOT VALID = only checks new or changed rows) ============
alter table appointments drop constraint if exists chk_phone_format;
alter table appointments add constraint chk_phone_format
  check (phone is null or phone ~ '^[6-9][0-9]{9}$') not valid;

alter table appointments drop constraint if exists chk_name_length;
alter table appointments add constraint chk_name_length
  check (char_length(trim(client_name)) between 2 and 80) not valid;

alter table appointments drop constraint if exists chk_slot_grid;
alter table appointments add constraint chk_slot_grid
  check (time >= time '09:00' and time <= time '17:30'
         and extract(minute from time) in (0, 30)) not valid;

alter table waitlist drop constraint if exists chk_wl_phone;
alter table waitlist add constraint chk_wl_phone
  check (phone ~ '^[6-9][0-9]{9}$') not valid;

-- ============ 3. Triggers ============
create or replace function set_updated_at() returns trigger
language plpgsql as $$
begin new.updated_at = now(); return new; end $$;

drop trigger if exists trg_set_updated_at on appointments;
create trigger trg_set_updated_at before update on appointments
  for each row execute function set_updated_at();

-- Business rules for CLIENT-made bookings (admin and seed rows are exempt)
create or replace function enforce_booking_rules() returns trigger
language plpgsql as $$
declare
  today_ist date := (now() at time zone 'Asia/Kolkata')::date;
  now_ist   time := (now() at time zone 'Asia/Kolkata')::time;
  upcoming  int;
begin
  if new.source = 'client' and new.status = 'Booked' then
    if tg_op = 'INSERT' or new.date is distinct from old.date or new.time is distinct from old.time then
      if new.date < today_ist or (new.date = today_ist and new.time <= now_ist) then
        raise exception 'Cannot book a slot in the past';
      end if;
      if new.date > today_ist + 60 then
        raise exception 'Bookings open only 60 days ahead';
      end if;
    end if;
    if new.phone is not null and (tg_op = 'INSERT' or old.status is distinct from 'Booked') then
      select count(*) into upcoming from appointments
       where phone = new.phone and status = 'Booked' and id <> new.id
         and (date > today_ist or (date = today_ist and time > now_ist));
      if upcoming >= 3 then
        raise exception 'Maximum 3 upcoming appointments per phone number';
      end if;
    end if;
  end if;
  return new;
end $$;

drop trigger if exists trg_booking_rules on appointments;
create trigger trg_booking_rules before insert or update on appointments
  for each row execute function enforce_booking_rules();

-- Audit trail (runs with elevated rights so the API never needs insert access to audit_log)
create or replace function log_appointment_change() returns trigger
language plpgsql security definer set search_path = public as $$
begin
  if tg_op = 'INSERT' then
    insert into audit_log (appointment_id, action, new_status, details)
    values (new.id, 'created', new.status,
            jsonb_build_object('source', new.source, 'date', new.date, 'time', new.time));
  elsif new.status is distinct from old.status then
    insert into audit_log (appointment_id, action, old_status, new_status, details)
    values (new.id, 'status_changed', old.status, new.status,
            jsonb_build_object('date', new.date, 'time', new.time));
  elsif new.date is distinct from old.date or new.time is distinct from old.time then
    insert into audit_log (appointment_id, action, old_status, new_status, details)
    values (new.id, 'rescheduled', old.status, new.status,
            jsonb_build_object('from', old.date || ' ' || old.time, 'to', new.date || ' ' || new.time));
  end if;
  return null;
end $$;

drop trigger if exists trg_audit on appointments;
create trigger trg_audit after insert or update on appointments
  for each row execute function log_appointment_change();

-- ============ 4. Row Level Security ============
alter table appointments enable row level security;
alter table waitlist     enable row level security;
alter table audit_log    enable row level security;

drop policy if exists "anon read"   on appointments;
drop policy if exists "anon insert" on appointments;
drop policy if exists "anon update" on appointments;
drop policy if exists "anon delete" on appointments;
drop policy if exists "app read"    on appointments;
drop policy if exists "app insert"  on appointments;
drop policy if exists "app update"  on appointments;

create policy "app read"   on appointments for select to anon, authenticated using (true);
create policy "app insert" on appointments for insert to anon, authenticated
  with check (status in ('Booked', 'Done', 'No-show'));
create policy "app update" on appointments for update to anon, authenticated
  using (true) with check (true);
-- No DELETE policy on purpose: the API can never delete an appointment. Cancel = status update.

drop policy if exists "wl read"   on waitlist;
drop policy if exists "wl insert" on waitlist;
drop policy if exists "wl update" on waitlist;
drop policy if exists "wl delete" on waitlist;
create policy "wl read"   on waitlist for select to anon, authenticated using (true);
create policy "wl insert" on waitlist for insert to anon, authenticated with check (notified = false);
create policy "wl update" on waitlist for update to anon, authenticated using (true) with check (true);

drop policy if exists "audit read" on audit_log;
create policy "audit read" on audit_log for select to anon, authenticated using (true);
-- No insert/update/delete policy: only the trigger writes to audit_log.

-- ============ 5. Realtime ============
do $$ begin
  alter publication supabase_realtime add table appointments;
exception when duplicate_object then null; end $$;
```

